# Copy this file to .env and fill in your keys.

# Uses local Ollama (http://localhost:11434) — no API key needed.
# Install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct

# Job data source: "sample" (bundled dataset) or "adzuna" (live API, needs keys below)
JOB_PROVIDER=sample

# Only needed when JOB_PROVIDER=adzuna — register at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
