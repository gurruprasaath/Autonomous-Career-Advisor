# Copy this file to .env and fill in your keys.

# Uses local Ollama (http://localhost:11434) — no API key needed.
# Install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct

# Job data source: "sample" (bundled dataset) or "adzuna" (live API, needs keys below)
JOB_PROVIDER=sample

# Only needed when JOB_PROVIDER=adzuna — register at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional — without this, resource curation falls back to mock YouTube
# results. Register at https://console.cloud.google.com/apis/credentials
# and enable the YouTube Data API v3.
YOUTUBE_API_KEY=
